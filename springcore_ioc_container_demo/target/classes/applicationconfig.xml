<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="java" class="com.demo.services.Java"/>
    <bean id="sb" class="com.demo.services.SpringBoot"/>
    <bean id="pgcpdc" class="com.demo.services.PGCPDC">
        <!-- for Setter injection -->
        <!-- <property ref="java" name="course"> </property> -->
        <!-- for Constructor Injection -->
        <constructor-arg ref="java" name="course"></constructor-arg> 
    </bean>

</beans>